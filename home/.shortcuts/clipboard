#!/bin/zsh
# shellcheck shell=bash

# variables
target=$(termux-clipboard-get)

# colors
LR='\e[1;31m' # light red
LG='\e[1;32m' # light green
LY='\e[1;33m' # light yellow
LB='\e[1;34m' # light blue
R='\e[0m'     # no color

# options
echo "Analysing URL..."
echo "[$target]"
echo ""
echo "${LG}What should i do?"
echo ""
echo "${LY}v${R}) Download video"
echo "${LY}f${R}) Download video (Select format)"
echo "${LY}m${R}) Download music"
echo "${LY}k${R}) Download with gallery-dl"
echo "${LY}i${R}) Download with gallery-dl (images only)"
echo "${LY}w${R}) Download with wget"
echo "${LY}a${R}) Download with aria2"
echo "${LY}g${R}) Clone git"
echo "${LY}s${R}) Clone website"
echo "${LY}x${R}) ${LR}Exit${R}"

read CHOICE
case $CHOICE in

################
# YT-DLP VIDEO #
################

v)
  yt-dlp -f "bv*[ext=mp4]+ba[ext=m4a]/b[ext=mp4] / bv*+ba/b" --no-mtime -o "storage/downloads/Termux/Videos/%(title)s.%(ext)s" $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

#################
# YT-DLP FORMAT #
#################

f)
  yt-dlp -F $target
  echo "${LG}Select the format:${R}"
  read FORMAT
  yt-dlp -f $FORMAT --no-mtime -o "storage/downloads/Termux/Videos/%(title)s.%(ext)s" $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

################
# YT-DLP MUSIC #
################

m)
  yt-dlp -x --audio-format mp3 --audio-quality 0 --embed-thumbnail --convert-thumbnail jpg --ppa "EmbedThumbnail+ffmpeg_o:-c:v mjpeg -q:v 2 -vf \"crop=min(iw\\,ih):min(iw\\,ih),scale=720:720\"" --exec ffprobe --add-metadata --no-mtime -o "storage/downloads/Termux/Music/%(artist,uploader)s - %(title)s.%(ext)s" $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

##############
# GALLERY-DL #
##############

k)
  gallery-dl --no-mtime -f '{filename}.{extension}' -d "storage/downloads/Termux/GalleryDL" $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

#####################
# GALLERY-DL IMAGES #
#####################

i)
  gallery-dl --no-mtime -f '{filename}.{extension}' --filter "extension in ('apng','bmp','dng','gif','heic','jpeg','jpg','png','svg','tiff','webp')" -d "storage/downloads/Termux/GalleryDL" $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

########
# WGET #
########

w)
  wget -P storage/downloads/Termux/Wget $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

#########
# ARIA2 #
#########

a)
  aria2c -d storage/downloads/Termux/Aria2 $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

#############
# CLONE GIT #
#############

g)
  echo "${LG}Enter repository name:${R}"
  read REPO
  git clone $target "storage/downloads/Termux/Git/$REPO"
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

#################
# CLONE WEBSITE #
#################

s)
  wget --mirror --page-requisites --html-extension --convert-links -P ~/storage/downloads/Termux/Websites $target
  if [ $? -eq 0 ]; then
    termux-toast -g top -b white -c black Download finished
    echo "${LB}Done.${R}"
    sleep 3s
  else
    termux-toast -g top -b white -c red Error
    echo "${LR}Error."
    echo ""
    echo "${R}Press any key to exit..."
    read -k 1 -r -s
  fi
  ;;

########
# EXIT #
########

x)
  echo "${LB}Bye ;)${R}"
  sleep 2s
  ;;

esac
