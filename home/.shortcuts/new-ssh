#!/bin/zsh
# shellcheck shell=bash

# colors
LG='\e[1;32m' # light green
LY='\e[1;33m' # light yellow
LB='\e[1;34m' # light blue
R='\e[0m'     # no color

# name
echo "${LG}Insert Server name"
echo "${R}Press ENTER to cancel"
read NAME
if [ $NAME ]; then
  # remove whitespace
  NAME=${NAME// /-}
else
  exit 0
fi

# address
clear
echo "${LG}Insert Server address${R}"
read ADDRESS

# port
clear
echo "${LG}Insert Server port"
echo "${R}Press ENTER for default port (22)"
read PORT
if [ $PORT ]; then
  PORT1="-p $PORT "
else
  PORT="22"
  PORT1=""
fi

# user
clear
echo "${LG}Insert user${R}"
read SSHUSER

# password
clear
echo "${LG}Insert password"
echo "${R}Press ENTER to skip"
read PASS
if [ $PASS ]; then
  PASS1="sshpass -p '$PASS' "
else
  PASS1=""
fi

# keyfile
clear
echo "${LG}Import ssh Key? ${R}(${LY}y${R}/${LY}n${R})"
echo "${R}Note: file will be stored at ~/keys as $NAME-key"
read CHOICE
case $CHOICE in
y)
  mkdir -p ~/keys
  termux-storage-get "$HOME/keys/$NAME-key"
  KEY="$NAME-key"
  ;;
n)
  sleep 0s
  ;;
esac

# confirmation
clear
sleep 2s
echo "${LB}Confirm connection details"
echo ""
echo "${R}Name: $NAME"
echo "Address: $ADDRESS:$PORT"
echo "User: $SSHUSER"
echo "Password: $PASS"
echo "Key: $KEY"
echo ""
echo "Press any key to finish."
read -k 1 -r -s
find "$HOME/keys/$NAME-key"
if [ $? -eq 0 ]; then
  KEY1="-i ~/keys/$KEY "
else
  KEY1=""
fi

# create shortcut
cat > "$HOME/.shortcuts/ssh-$NAME"<< EOF
#!/bin/zsh
clear
${PASS1}ssh $PORT1$KEY1$SSHUSER@$ADDRESS
EOF

# copy shortcut image
cp ~/.shortcuts/icons/ssh-.png ~/.shortcuts/icons/ssh-$NAME.png

# delete old alias
sed -i "/^alias ssh-${NAME}=/d" ~/.zshrc

# create alias
echo -e "alias ssh-${NAME}='. ~/.shortcuts/ssh-$NAME'" >> ~/.zshrc
